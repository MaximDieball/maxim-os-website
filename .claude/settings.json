{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(docker compose *)",
      "Bash(make *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash)"
    ]
  }
}